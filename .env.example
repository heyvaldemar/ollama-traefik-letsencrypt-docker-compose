# Ollama + Open WebUI + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested without touching your
# .env. To pin a different version yourself, uncomment and set:
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…
# OLLAMA_IMAGE_TAG=ollama/ollama:0.33.2@sha256:…
# WEBUI_IMAGE_TAG=ghcr.io/open-webui/open-webui:0.11@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.ollama.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#
# Generate a new BCrypt hash (replace YOUR_STRONG_PASSWORD):
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# Or using docker without installing apache2-utils:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Ollama + Open WebUI
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname for the Open WebUI. Must resolve to this server's public
# IP for the Let's Encrypt TLS-ALPN challenge. REQUIRED.
OLLAMA_HOSTNAME=ollama.example.com

# Models pulled automatically on first start (comma-separated). The default
# downloads several GB. Set empty to skip automatic model installation.
# OLLAMA_INSTALL_MODELS=llama3,codegemma,mistral

# NVIDIA GPU count for the (commented) GPU block in the compose file.
# OLLAMA_GPU_COUNT=all

# Backup Variables (defaults shown). The backups service copies each SQLite
# database consistently (Python's sqlite3 backup API, no application stop) and
# archives the rest of the data directory on a loop; files land in the
# open-webui-backups volume.
# OPEN_WEBUI_BACKUP_INIT_SLEEP=30m
# OPEN_WEBUI_BACKUP_INTERVAL=24h
# OPEN_WEBUI_BACKUP_PRUNE_DAYS=7
# OPEN_WEBUI_BACKUPS_PATH=/srv/open-webui/backups
# OPEN_WEBUI_BACKUP_NAME=open-webui-database-backup
# OPEN_WEBUI_DATA_BACKUP_NAME=open-webui-data-backup

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# OLLAMA_IMAGE_VERSION=0.33.2
# WEBUI_IMAGE_VERSION=0.11

# OPEN_WEBUI_MEMORY_LIMIT=1g
# OPEN_WEBUI_CPU_LIMIT=1.0
# OPEN_WEBUI_MEMORY_RESERVATION=128m
# OPEN_WEBUI_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1

# The ollama service ships with no memory ceiling on purpose: its working set
# is whichever model you load. Set this once you know which models you run,
# leaving headroom above the largest.
# OLLAMA_MEMORY_LIMIT=16g
